{
  "version": 1,
  "description": "Shared by web/lib/investigation/sourceLinks.test.ts and the MCP tellagen_build_source_link tests (CORE-776). Same input, same output string. Explore uses the Grafana `left` parameter (CORE-761); orgId: null leaves orgId out, an absent orgId means 1.",
  "explore": [
    {
      "name": "prometheus with a datasource uid and the incident window",
      "input": {
        "baseUrl": "https://grafana.example.com",
        "datasource": "prom-uid-1",
        "query": "sum(rate(http_requests_total{service=\"checkout\"}[5m]))",
        "from": "2026-06-18T08:40:00Z",
        "to": "2026-06-18T10:20:00Z",
        "orgId": null
      },
      "url": "https://grafana.example.com/explore?left=%7B%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22expr%22%3A%22sum(rate(http_requests_total%7Bservice%3D%5C%22checkout%5C%22%7D%5B5m%5D))%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%221781772000000%22%2C%22to%22%3A%221781778000000%22%7D%2C%22datasource%22%3A%22prom-uid-1%22%7D"
    },
    {
      "name": "loki with no datasource, relative times and no org",
      "input": {
        "baseUrl": "https://grafana.example.com/",
        "query": "{app=\"api\"} |= \"timeout\"",
        "from": "now-6h",
        "to": "now",
        "orgId": null
      },
      "url": "https://grafana.example.com/explore?left=%7B%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22expr%22%3A%22%7Bapp%3D%5C%22api%5C%22%7D%20%7C%3D%20%5C%22timeout%5C%22%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-6h%22%2C%22to%22%3A%22now%22%7D%7D"
    },
    {
      "name": "sub-path install with an org",
      "input": {
        "baseUrl": "https://tools.example.com/grafana",
        "datasource": "loki-uid-2",
        "query": "{job=\"worker\"}",
        "from": "2026-06-18T08:40:00Z",
        "orgId": 3
      },
      "url": "https://tools.example.com/grafana/explore?orgId=3&left=%7B%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22expr%22%3A%22%7Bjob%3D%5C%22worker%5C%22%7D%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%221781772000000%22%2C%22to%22%3A%22now%22%7D%2C%22datasource%22%3A%22loki-uid-2%22%7D"
    },
    {
      "name": "legacy default keeps orgId=1",
      "input": {
        "baseUrl": "https://grafana.example.com",
        "query": "up"
      },
      "url": "https://grafana.example.com/explore?orgId=1&left=%7B%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22expr%22%3A%22up%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D"
    }
  ],
