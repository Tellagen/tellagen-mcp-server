{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tellagen.dev/contracts/runbooks/v1/runbook-definition.schema.json",
  "title": "Tellagen legacy investigation runbook definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "applies_to",
    "required_sources",
    "safety_level",
    "body_markdown"
  ],
  "properties": {
    "schema_version": {"const": "v1_markdown"},
    "applies_to": {"type": "object"},
    "required_sources": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 256},
      "maxItems": 64
    },
    "safety_level": {"type": "string", "minLength": 1, "maxLength": 64},
    "body_markdown": {"type": "string", "minLength": 1, "maxLength": 131072}
  }
}
